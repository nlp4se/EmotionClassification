# Copy to `.env` and fill in. Never commit `.env`.

# --- Proprietary APIs (RQ2 classification + RQ4 generation) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Legacy alias still accepted by the Anthropic client:
CLAUDE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# --- Local open-source generative models via Ollama ---
# Install: https://ollama.com  then e.g. `ollama pull gemma3:27b`
OLLAMA_HOST=http://localhost:11434

# Optional OpenAI-compatible gateway override
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
